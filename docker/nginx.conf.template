# Drupal 11 nginx config (based on the standard Drupal recipe).
server {
  listen ${PORT} default_server;
  listen [::]:${PORT} default_server;
  server_name _;
  root /var/www/html/web;
  index index.php;
  client_max_body_size 32M;

  location = /favicon.ico { log_not_found off; access_log off; }
  location = /robots.txt  { allow all; log_not_found off; access_log off; }

  # Block hidden files, text logs, and PHP outside of index.php / update.php.
  location ~ \..*/.*\.php$ { return 403; }
  location ~ ^/sites/.*/private/ { return 403; }
  location ~ ^/sites/[^/]+/files/.*\.php$ { deny all; }
  location ~ (^|/)\. { return 403; }
  location ~* \.(txt|log)$ { deny all; }
  location ~ /vendor/.*\.php$ { deny all; return 404; }

  location / {
    try_files $uri /index.php?$query_string;
  }

  location @rewrite {
    rewrite ^ /index.php;
  }

  # Image styles are generated by Drupal on first request.
  location ~ ^/sites/.*/files/styles/ {
    try_files $uri @rewrite;
  }

  # Aggregated CSS/JS are generated on demand too.
  location ~ ^(/[a-z\-]+)?/system/files/ {
    try_files $uri /index.php?$query_string;
  }
  location ~ ^/sites/.*/files/(css|js)/ {
    try_files $uri @rewrite;
  }

  location ~ '\.php$|^/update.php' {
    fastcgi_split_path_info ^(.+?\.php)(|/.*)$;
    try_files $fastcgi_script_name =404;
    include fastcgi_params;
    fastcgi_param HTTP_PROXY "";
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_param PATH_INFO $fastcgi_path_info;
    fastcgi_param QUERY_STRING $query_string;
    fastcgi_intercept_errors on;
    fastcgi_pass 127.0.0.1:9000;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
    try_files $uri @rewrite;
    expires max;
    log_not_found off;
  }
}
