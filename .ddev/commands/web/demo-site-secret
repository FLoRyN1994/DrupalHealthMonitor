#!/usr/bin/env bash

## Description: Print a local demo client's generated HMAC secret
## Usage: demo-site-secret [client-one|client-two]
## Example: ddev demo-site-secret client-one

set -eu -o pipefail

site_name="${1:-}"
if [[ "${site_name}" != "client-one" && "${site_name}" != "client-two" ]]; then
  printf 'Usage: ddev demo-site-secret [client-one|client-two]\n' >&2
  exit 1
fi

settings_file="/var/www/html/web/sites/${site_name}/settings.local.php"
if [[ ! -f "${settings_file}" ]]; then
  printf 'Demo site is not provisioned. Run ddev demo-sites first.\n' >&2
  exit 1
fi

php -r '$settings = []; require $argv[1]; echo $settings["hm_agent_secret"], PHP_EOL;' "${settings_file}"
