{#
/**
 * @file
 * Application shell for authenticated and utility pages.
 */
#}
<div class="hm-app-shell">
  <header class="hm-app-header">
    <div class="hm-app-header__inner">
      <a class="hm-brand" href="{{ path('<front>') }}" rel="home" aria-label="Drupal Health Monitor home">
        <span class="hm-brand__mark" aria-hidden="true">
          <svg viewBox="0 0 36 36" role="img">
            <path d="M18 2.5 31 8v9.1c0 8-5.2 13.8-13 16.4C10.2 30.9 5 25.1 5 17.1V8l13-5.5Z"/>
            <path d="m10 19 4-4 3 3 5-7 4 4"/>
          </svg>
        </span>
        <span class="hm-brand__text"><strong>Health Monitor</strong><small>for Drupal fleets</small></span>
      </a>

      {% if logged_in %}
        <nav class="hm-app-nav" aria-label="Product navigation">
          <a href="{{ path('hm_core.dashboard') }}">Overview</a>
          <a href="{{ path('view.hm_sites.page_1') }}">Sites</a>
          <a href="{{ path('view.hm_clients.page_1') }}">Clients</a>
          <a href="{{ path('entity.hm_finding.collection') }}">Findings</a>
          <a href="{{ path('entity.hm_ai_report.collection') }}">Reports</a>
        </nav>
        <div class="hm-app-header__actions">
          <a class="hm-header-link" href="{{ path('user.page') }}">Account</a>
          <a class="hm-button hm-button--small hm-button--ghost" href="{{ path('user.logout') }}">Sign out</a>
        </div>
      {% else %}
        <div class="hm-app-header__actions">
          <a class="hm-header-link" href="{{ path('<front>') }}#capabilities">Product</a>
          <a class="hm-button hm-button--small" href="{{ path('user.login') }}">Sign in</a>
        </div>
      {% endif %}
    </div>
  </header>

  {% if page.highlighted %}<div class="hm-app-alerts">{{ page.highlighted }}</div>{% endif %}

  <div class="hm-app-body{{ page.sidebar_first ? ' hm-app-body--with-sidebar' }}">
    {% if page.sidebar_first %}
      <aside class="hm-app-sidebar" aria-label="Administration navigation">{{ page.sidebar_first }}</aside>
    {% endif %}
    <main class="hm-app-main">
      <a id="main-content" tabindex="-1"></a>
      {% if page.breadcrumb %}<div class="hm-breadcrumb-wrap">{{ page.breadcrumb }}</div>{% endif %}
      {% if page.help %}<div class="hm-app-help">{{ page.help }}</div>{% endif %}
      <div class="hm-app-content">{{ page.content }}</div>
    </main>
  </div>

  <footer class="hm-app-footer"><span>Drupal Health Monitor</span><span>Deterministic analysis · signed collection · auditable reports</span></footer>
</div>
