<article{{ attributes.addClass('site-card') }}>
  <div class="site-card__topline"><span></span><span>{{ environment }}</span><b>{{ status }}</b></div>
  <div class="site-card__header">
    <div>
      <h2 class="site-card__title"><a href="{{ detail_url }}">{{ name }}</a></h2>
      <a class="site-card__url" href="{{ base_url }}" target="_blank" rel="noopener noreferrer">{{ base_url }} <span aria-hidden="true">↗</span></a>
    </div>
    {{ include('hm_theme:health-badge', { score: health_score }, with_context = false) }}
  </div>
  <div class="site-card__footer">
    <span class="site-card__finding-count"><i></i>{{ open_findings }} open {{ open_findings == 1 ? 'finding' : 'findings' }}</span>
    <a class="site-card__details" href="{{ detail_url }}">Inspect site <span aria-hidden="true">→</span><span class="visually-hidden"> {{ name }}</span></a>
  </div>
</article>
