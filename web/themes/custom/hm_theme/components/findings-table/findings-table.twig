<div{{ attributes.addClass('findings-table') }}>
  {% if findings %}
    <div class="findings-table__scroll">
      <table>
        <caption>{{ caption }}</caption>
        <thead>
          <tr>
            <th scope="col">Site</th>
            <th scope="col">Project</th>
            <th scope="col">Type</th>
            <th scope="col">Severity</th>
            <th scope="col">Current</th>
            <th scope="col">Recommended</th>
          </tr>
        </thead>
        <tbody>
          {% for finding in findings %}
            <tr>
              <th scope="row"><a href="{{ finding.site_url }}">{{ finding.site_name }}</a></th>
              <td>{{ finding.project_name }}</td>
              <td>{{ finding.type }}</td>
              <td><span class="findings-table__severity findings-table__severity--{{ finding.severity }}">{{ finding.severity }}</span></td>
              <td>{{ finding.current_version ?: '—' }}</td>
              <td>{{ finding.recommended_version ?: '—' }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p class="findings-table__empty">No open findings. The monitored fleet is clear.</p>
  {% endif %}
</div>
