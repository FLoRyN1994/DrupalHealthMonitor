<?xml version="1.0" encoding="UTF-8"?>
<!-- Drupal coding standards (drupal/coder, part of drupal/core-dev) for custom code. -->
<ruleset name="health_monitor">
  <description>Drupal and DrupalPractice standards for custom code.</description>
  <file>web/modules/custom</file>
  <file>web/themes/custom</file>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,txt,md,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/.gitkeep</exclude-pattern>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
